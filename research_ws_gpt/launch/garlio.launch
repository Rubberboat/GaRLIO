<launch>
  <arg name="config"/>
  <param name="use_sim_time" value="true"/>
  <rosparam command="load" file="$(arg config)"/>
  <node pkg="garlio" type="cloudProcess" name="pointProcess" output="screen" required="true"/>
  <node pkg="garlio" type="lidarMapping" name="lidarMapping" output="screen" required="true"/>
</launch>
